{
  "name": "@nymrel/proof-ledger",
  "version": "2.0.0",
  "description": "Versioned TypeScript and Python cryptographic attestation protocol with RFC 8785, RFC 6962, HMAC-SHA256, and Ed25519.",
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "homepage": "https://nymrel.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/nymrel-proof-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/nymrel/nymrel-proof-ledger/issues"
  },
  "keywords": [
    "cryptography",
    "attestation",
    "merkle-tree",
    "proof-of-execution",
    "audit-trail",
    "machine-trust",
    "nymrel",
    "rfc8785",
    "rfc6962",
    "ed25519",
    "hmac-sha256"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core/canonical": {
      "types": "./dist/src/core/canonical.d.ts",
      "import": "./dist/src/core/canonical.js"
    },
    "./core/merkle": {
      "types": "./dist/src/core/merkle.d.ts",
      "import": "./dist/src/core/merkle.js"
    },
    "./core/signer": {
      "types": "./dist/src/core/signer.d.ts",
      "import": "./dist/src/core/signer.js"
    },
    "./core/receipt": {
      "types": "./dist/src/core/receipt.d.ts",
      "import": "./dist/src/core/receipt.js"
    },
    "./core/envelope": {
      "types": "./dist/src/core/envelope.d.ts",
      "import": "./dist/src/core/envelope.js"
    },
    "./visual/badge": {
      "types": "./dist/src/visual/badge.d.ts",
      "import": "./dist/src/visual/badge.js"
    }
  },
  "bin": {
    "proof-ledger": "./bin/proof-ledger.js"
  },
  "files": [
    "dist/src",
    "bin",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:ts",
    "test:ts": "node dist/test/ts/run-tests.js",
    "test:py": "uv run --isolated --no-project --python 3.13 --with \"cryptography>=50.0.1,<51\" --with \"rfc8785==0.1.4\" python -m unittest discover -s test/python -p \"test_*.py\"",
    "test:all": "npm run test && npm run test:py",
    "test:release": "npm run typecheck && npm run test:all",
    "prepublishOnly": "npm run test:release"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
